# Automation Readiness Scorecard (Typeform/Tally/etc)
# Primary CTA links here when set
NEXT_PUBLIC_SCORECARD_URL=

# MailerLite API (server-side only — never expose to the client)
MAILERLITE_API_KEY=              # Your MailerLite API key (Settings > Integrations > API)
MAILERLITE_GROUP_ID=             # The subscriber group/list to add audit respondents to

# MailerLite newsletter embed
# NEXT_PUBLIC_MAILERLITE_FORM_ID=          # e.g. "abc123" from MailerLite > Forms > Embed
# NEXT_PUBLIC_MAILERLITE_LANDING_URL=      # fallback signup landing page URL

# Proposal Pipeline Scorecard (/scorecard)
# Live by default. Set to "false" (and redeploy) to put the nav, homepage [05] and /assessment back on the old audit.
NEXT_PUBLIC_SCORECARD_LIVE=true
NEXT_PUBLIC_SITE_URL=             # e.g. https://www.madewithmake.com (used in email links)
DATABASE_URL=                     # Neon connection string (postgres://...neon.tech/...?sslmode=require); server only, never expose. Run supabase/migrations/0001_scorecard_submissions.sql in the Neon SQL editor first (plain Postgres; the folder name is historical)
RESEND_API_KEY=                   # verify madewithmake.com in Resend first
SCORECARD_FROM_EMAIL="Wambui at Made With Make <wambui@madewithmake.com>"
SCORECARD_NOTIFY_EMAIL=wambui@madewithmake.com
BOOKING_URL=                      # optional; defaults to the 30-minute strategy-call schedule embedded on /contact-us
FREE_DRAFT_URL=/proposal-pipeline#free-draft
PLAYBOOK_URL=                     # the 5-Stage Proposal Pipeline Playbook; its button is hidden when empty (CHECKLIST_URL still works as the old name)
GET_READY_CHECKLIST_URL=           # checklist for the "almost" results page; hidden when empty
STARTER_CHECKLIST_URL=             # checklist for the "playbook" results page; hidden when empty
DEMO_VIDEO_URL=                   # optional; the demo slot is hidden when empty
HOURLY_RATE=60
CRON_SECRET=                      # sent as "Authorization: Bearer ..." by the cron caller

# Contentful blog posts (server-side only — no NEXT_PUBLIC_ prefix)
# Space "Blank", content type "madeWithMakeBlog". If unset, the blog has no posts.
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=          # Settings > API keys > Content Delivery API access token
# CONTENTFUL_ENVIRONMENT=master

# Optional: Cal.com, Analytics, etc.
# NEXT_PUBLIC_CALCOM_API_KEY=
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
